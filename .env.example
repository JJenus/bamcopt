# --- required ---
JWT_SECRET=change-me-to-a-long-random-string
# PostgreSQL: either a single URL ...
DATABASE_URL=postgres://user:password@localhost:5432/bancopt_db
# ... or the individual values (DATABASE_URL wins when set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bancopt_db
# DB_USER=postgres
# DB_PASSWORD=
# set to true for hosted databases that need TLS
DB_SSL=false
# create missing tables on boot (never alters existing ones). Use once on a fresh database.
DB_SYNC=false
# --- sign-in ---
# Login asks for an e-mailed one-time code by default. Set to false to sign in with the password alone
# (login and registration then return a session straight away).
OTP_ON=true
# --- super admin (optional) ---
# Owner account that oversees the administrators (/super). Created only when BOTH are set; use a different e-mail from ADMIN_EMAIL.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Super Admin
# Code step for the super admin even when OTP_ON=false: auto (default, when mail is configured) | on | off
# SUPERADMIN_OTP=auto
# --- sign-in history ---
# Number of reverse proxies in front of the app; the client IP is the entry they appended to X-Forwarded-For.
TRUST_PROXY_HOPS=1
# City/country for sign-ins is looked up from the IP in the background. GEOIP=off disables it; GEOIP_URL changes the provider ({ip} is replaced).
# GEOIP=off
# GEOIP_URL=https://ipwho.is/{ip}
# --- retention (days; 0 keeps forever) ---
# SECURITY_LOG_RETENTION_DAYS=365
# AUDIT_RETENTION_DAYS=0
# SESSION_RETENTION_DAYS=30
# --- mail (optional in dev; e-mails are skipped when SMTP_PASS is empty) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@bancopt.com
SMTP_PASS=
# Email links/assets: set the real origin for this environment when enabling SMTP.
# Required in production; development defaults to http://localhost:3000 (or PORT).
APP_URL=

# --- public website (visible to browsers; never put secrets here) ---
NUXT_PUBLIC_APP=Bancopt
NUXT_PUBLIC_SUPPORT_EMAIL=support@bancopt.com
NUXT_PUBLIC_MOBILE="+49 (178) 793 1942"
NUXT_PUBLIC_SUPPORT_HOURS="Contact us by email for account and product enquiries."
# Optional fallback for email origin. Browser links/canonicals use the current request origin.
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_LOGO_URL=/assets/media/logos/logo-ban.png
NUXT_PUBLIC_LEGAL_ENTITY=Bancopt
NUXT_PUBLIC_BUSINESS_ADDRESS=
NUXT_PUBLIC_LEGAL_UPDATED=2026-11-04

# --- optional build-time isolation ---
# Use separate directories for verification while a dev server is running.
# Default: .nuxt
# NUXT_BUILD_DIR=/tmp/opencode/bancopt-build
