# --- required ---
JWT_SECRET=change-me-to-a-long-random-string
# PostgreSQL: either a single URL ...
DATABASE_URL=postgres://user:password@localhost:5432/bancopt_db
# ... or the individual values (DATABASE_URL wins when set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bancopt_db
# DB_USER=postgres
# DB_PASSWORD=
# set to true for hosted databases that need TLS
DB_SSL=false
# create missing tables on boot (never alters existing ones). Use once on a fresh database.
DB_SYNC=false
# --- mail (optional in dev; e-mails are skipped when SMTP_PASS is empty) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@bancopt.com
SMTP_PASS=
# used in e-mail links; keep aligned with NUXT_PUBLIC_SITE_URL
APP_URL=https://www.bancopt.com

# --- public website (visible to browsers; never put secrets here) ---
NUXT_PUBLIC_APP=Bancopt
NUXT_PUBLIC_SUPPORT_EMAIL=support@bancopt.com
NUXT_PUBLIC_MOBILE="+49 (178) 793 1942"
NUXT_PUBLIC_SUPPORT_HOURS="Contact us by email for account and product enquiries."
NUXT_PUBLIC_SITE_URL=https://www.bancopt.com
NUXT_PUBLIC_LOGO_URL=/assets/media/logos/logo-ban.png
NUXT_PUBLIC_LEGAL_ENTITY=Bancopt
NUXT_PUBLIC_BUSINESS_ADDRESS=
NUXT_PUBLIC_LEGAL_UPDATED=2026-11-04

# --- optional build-time isolation ---
# Use separate directories for verification while a dev server is running.
# Default: .nuxt
# NUXT_BUILD_DIR=/tmp/opencode/bancopt-build
