# --- required ---
JWT_SECRET=change-me-to-a-long-random-string
DB_HOST=localhost
DB_NAME=bancopt_db
DB_USER=root
DB_PASSWORD=
# --- mail (optional in dev; emails are skipped when SMTP_PASS is empty) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@bancopt.com
SMTP_PASS=
# --- misc ---
# create missing tables on boot (never alters existing ones)
DB_SYNC=false
APP_URL=https://www.bancopt.com
