# --- required ---
JWT_SECRET=change-me-to-a-long-random-string
# PostgreSQL: either a single URL ...
DATABASE_URL=postgres://user:password@localhost:5432/bancopt_db
# ... or the individual values (DATABASE_URL wins when set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bancopt_db
# DB_USER=postgres
# DB_PASSWORD=
# set to true for hosted databases that need TLS
DB_SSL=false
# create missing tables on boot (never alters existing ones). Use once on a fresh database.
DB_SYNC=false
# --- mail (optional in dev; e-mails are skipped when SMTP_PASS is empty) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@bancopt.com
SMTP_PASS=
# used in e-mail links
APP_URL=https://www.bancopt.com
